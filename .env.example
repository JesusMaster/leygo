PORT=4000
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# true si tu Redis exige TLS (URL rediss://)
REDIS_TLS=false
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_FEDERATION=false
GRAPHQL_PATH=/graphql
LOG_LEVEL=info

# Nostr Gateway (Buzz): apagado por defecto. Se activa en el asistente (Ajustes → Asistente de configuración → Buzz)
# o aquí: NOSTR_ENABLED=true + relay + canales. Sin NOSTR_PRIVATE_KEY se genera una identidad en DATA_DIR/nostr_keys.json.
NOSTR_ENABLED=false
NOSTR_RELAY_URL=
NOSTR_PRIVATE_KEY=
NOSTR_CHANNELS=
NOSTR_KINDS=9,11,1111,1,42
NOSTR_LISTEN_GLOBAL=true
NOSTR_REQUIRE_MENTION=true
NOSTR_ALLOWED_PUBKEYS=*
NOSTR_DEBUG_EVENTS=false
NOSTR_DEBUG_FIREHOSE=false
NOSTR_THREAD_FILTER=false
NOSTR_RESUBSCRIBE_SECONDS=30
NOSTR_WATCHDOG_PROBE=false
NOSTR_SUMMARY_SECONDS=900

# Presupuestos mensuales en USD por canal (telegram, buzz, a2a, api, system)
MONTHLY_BUDGET_USD=5
MONTHLY_BUDGET_USD_BUZZ=3
MONTHLY_BUDGET_USD_A2A=3
MONTHLY_BUDGET_USD_TELEGRAM=2

# Solo si corres ADK Web SIN src/index.ts (evita duplicar Telegram y el scheduler)
ADK_START_SERVICES=false

# A2A: sin esta clave el endpoint /a2a/v1 NO se monta
A2A_API_KEY=

# A2A: token(s) referenciados desde config/channels.json como "env:NOMBRE"
A2A_TOKEN_PARTNER=

# Clave de administración que exige la GUI (yisus-gui) en X-Admin-Key
ADMIN_API_KEY=

# Orígenes permitidos para la GUI (coma-separados). '*' abre a cualquiera: no recomendado.
GUI_ORIGIN=http://localhost:4200

# Ruta ABSOLUTA de la carpeta de datos (SQLite). Si no se define, se usa ./data
# relativo al directorio desde donde se lanza el proceso — origen de bases duplicadas.
DATA_DIR=

# Diagnóstico: agrega al 401 de A2A una pista sobre cuántos tokens ve la instancia.
# Solo para depurar; apágalo después.
A2A_DEBUG_401=false

# ─── Modelos ──────────────────────────────────────────────────────────────────
# Gemini por defecto (los demás proveedores se configuran en la GUI: Ajustes → Proveedores LLM)
GEMINI_API_KEY=
# Variables de agentes personalizados: AGENT_<SLUG>_<VAR> (p. ej. la clave que usa Banano para generar imágenes)
# AGENT_BANANO_GEMINI_API_KEY=

# ─── Datos y memoria ──────────────────────────────────────────────────────────
# En Docker, ./instalar.sh --redis --qdrant --ollama levanta solo los que elijas y ajusta estas URLs
# (redis, http://qdrant:6333, http://ollama:11434). Los que ya tengas en tu computador quedan en host.docker.internal.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: el modelo con que se vectoriza TODA la memoria. Elígelo en el asistente (paso Embeddings).
# Modelos distintos no son compatibles entre sí: cambiarlo después obliga a vaciar las colecciones de Qdrant.
# Sin EMBEDDING_MODEL se usa el modo histórico: Ollama con OLLAMA_EMBED_MODEL (nomic-embed-text, 768).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# ─── Google Workspace (OAuth2; `npm run google:oauth`) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth2callback

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Sesión nueva tras N minutos sin mensajes (cada turno paga todo el historial de la sesión)
TELEGRAM_SESSION_IDLE_MIN=240

# ─── Producción (docker-compose + Caddy): dominio del certificado TLS ────────
DOMAIN=

# ─── URLs públicas y zona horaria ─────────────────────────────────────────────
# Base pública de la API: enlaces de adjuntos y tarjeta A2A. Si PUBLIC_BASE_URL falta, se usa A2A_BASE_URL.
PUBLIC_BASE_URL=
A2A_BASE_URL=
SCHEDULER_TZ=America/Santiago

# ─── GUI (usuario/contraseña; `npm run gui:password` genera el hash) ──────────
GUI_USER=
# Entre comillas simples: el hash contiene `$` (docker compose lo interpretaría como variable).
GUI_PASSWORD_HASH=''

# Servicio de licencias de la cuenta empresa (por defecto https://licencias.leygo.cl).
# LICENCIAS_URL=
